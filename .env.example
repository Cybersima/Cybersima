# Copy to .env and fill in only what you need.
# Coinbase, Kraken, Gemini, Bitstamp, and Yahoo market data do NOT require keys.
# Binance is disabled by default (not available to US residents).

PULSEARB_HOST=0.0.0.0
PULSEARB_PORT=8080

# paper | live
PULSEARB_EXECUTION_MODE=paper

# Require this exact phrase before any live order is sent.
PULSEARB_LIVE_CONFIRM=

# Coinbase Advanced Trade (US live orders). Easiest: drop the downloaded JSON here:
#   keys/coinbase.json
# Optional instead of the JSON file:
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_API_JSON=

# Optional. Binance is off unless you set this to 1 (non-US only).
PULSEARB_ENABLE_BINANCE=0
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=0
