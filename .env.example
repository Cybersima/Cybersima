# Copy to .env and fill in only what you need.
# Coinbase, Kraken, Gemini, Bitstamp, and Yahoo market data do NOT require keys.
# Binance is disabled by default (not available to US residents).

SECURETRADE_HOST=0.0.0.0
SECURETRADE_PORT=8000
SECURETRADE_OPERATING_MODE=learn
SECURETRADE_EDITION=professional

# paper | live  — live stays locked until safety checks pass
SECURETRADE_EXECUTION_MODE=paper
SECURETRADE_LIVE_CONFIRM=

# Optional. Binance is off unless you set this to 1 (non-US only).
SECURETRADE_ENABLE_BINANCE=0
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=0

# Offline simulator
SECURETRADE_DEMO_ONLY=1
