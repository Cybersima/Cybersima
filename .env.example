# Copy to .env and fill in only what you need.
# Market data from Binance does NOT require keys.
# Live order placement DOES.

PULSEARB_HOST=0.0.0.0
PULSEARB_PORT=8080

# paper | live
PULSEARB_EXECUTION_MODE=paper

# Require this exact phrase before any live order is sent.
PULSEARB_LIVE_CONFIRM=

BINANCE_API_KEY=
BINANCE_API_SECRET=
# set to 1 to hit Binance testnet instead of production
BINANCE_TESTNET=0
