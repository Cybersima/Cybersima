# Copy to .env and fill in only what you need.
# Coinbase, Kraken, and Gemini market data do NOT require keys.
# OANDA and Robinhood feeds need their key files. Yahoo and Bitstamp stay off.
# Binance is disabled by default (not available to US residents).

# This computer only. For iPad on Wi-Fi set 0.0.0.0 — the lock PIN is required.
PULSEARB_HOST=127.0.0.1
PULSEARB_PORT=8080

# paper | live
PULSEARB_EXECUTION_MODE=paper

# Require this exact phrase before any live order is sent.
PULSEARB_LIVE_CONFIRM=

# Coinbase Advanced Trade (US live orders). Easiest: drop the downloaded JSON here:
#   keys/coinbase.json
# Optional instead of the JSON file:
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_API_JSON=

# Kraken live orders (if you do not use Coinbase). Drop:
#   keys/kraken.json
# with {"key":"...","secret":"..."} from Kraken (Query Funds + Create & Modify Orders, no Withdraw).
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
KRAKEN_API_JSON=

# OANDA (practice by default). Or drop keys/oanda.json.
OANDA_ACCOUNT_ID=
OANDA_ACCESS_TOKEN=
OANDA_ENVIRONMENT=practice
OANDA_API_JSON=

# Gemini live. Or drop keys/gemini.json.
GEMINI_API_KEY=
GEMINI_API_SECRET=
GEMINI_API_JSON=

# Robinhood crypto (no sandbox). Or drop keys/robinhood.json.
ROBINHOOD_API_KEY=
ROBINHOOD_PRIVATE_KEY=
ROBINHOOD_API_JSON=

# Optional. Binance is off unless you set this to 1 (non-US only).
PULSEARB_ENABLE_BINANCE=0
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=0
